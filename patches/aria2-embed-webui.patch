+/*
+ * WebUiServer.cc - Serve embedded Web UI assets over aria2's HTTP listener.
+ *
+ * This file is an addition to the aria2 source tree.  It is not part of the
+ * original aria2 distribution.
+ *
+ * Copyright (C) 2026 阿杰 <master@x-ac.cn>
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation, either version 3 of the License, or
+ * (at your option) any later version.
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+#include "WebUiServer.h"
+
+#include "common.h"
+
+#include "base64.h"
+
+#include <cstring>
+#include <map>
+
+#include <zlib.h>
+
+namespace aria2 {
+
+// Defined (generated) in WebUiBlob.cc.
+extern const char WEBUI_BLOB_B64[];
+extern const unsigned int WEBUI_BLOB_B64_LEN;
+
+namespace {
+
+struct Entry {
+  std::string mime;
+  const char* data;
+  size_t len;
+};
+
+uint32_t readU32(const char* p) {
+  return static_cast<uint32_t>(static_cast<unsigned char>(p[0])) |
+         (static_cast<uint32_t>(static_cast<unsigned char>(p[1])) << 8) |
+         (static_cast<uint32_t>(static_cast<unsigned char>(p[2])) << 16) |
+         (static_cast<uint32_t>(static_cast<unsigned char>(p[3])) << 24);
+}
+
+// Owns the inflated archive; Entry::data points into it.  Never mutated after
+// init(), so the pointers stay valid for the process lifetime.
+std::string g_blob;
+std::map<std::string, Entry> g_map;
+bool g_ready = false;
+
+void init() {
+  if (g_ready) {
+    return;
+  }
+  g_ready = true;
+
+  std::string b64(WEBUI_BLOB_B64, WEBUI_BLOB_B64_LEN);
+  std::string container = base64::decode(b64.begin(), b64.end());
+  if (container.size() < 4) {
+    return;
+  }
+  uint32_t rawLen = readU32(container.data());
+  if (rawLen < 12 || rawLen > 512u * 1024u * 1024u) {
+    return;
+  }
+  g_blob.resize(rawLen);
+  uLongf dstLen = rawLen;
+  int rc = uncompress(reinterpret_cast<Bytef*>(&g_blob[0]), &dstLen,
+                      reinterpret_cast<const Bytef*>(container.data()) + 4,
+                      container.size() - 4);
+  if (rc != Z_OK || dstLen != rawLen) {
+    g_blob.clear();
+    return;
+  }
+
+  const char* b = g_blob.data();
+  size_t n = g_blob.size();
+  if (std::memcmp(b, "AWEB", 4) != 0) {
+    g_blob.clear();
+    return;
+  }
+  size_t p = 4;
+  p += 4; // skip version
+  uint32_t count = readU32(b + p);
+  p += 4;
+  for (uint32_t i = 0; i < count; ++i) {
+    if (p + 4 > n) {
+      break;
+    }
+    uint32_t pathLen = readU32(b + p);
+    p += 4;
+    std::string path(b + p, pathLen);
+    p += pathLen;
+    uint32_t mimeLen = readU32(b + p);
+    p += 4;
+    std::string mime(b + p, mimeLen);
+    p += mimeLen;
+    uint32_t dataLen = readU32(b + p);
+    p += 4;
+    const char* data = b + p;
+    p += dataLen;
+    g_map[path] = Entry{std::move(mime), data, dataLen};
+  }
+}
+
+} // namespace
+
+bool WebUiServer::serve(const std::string& requestPath,
+                        std::string& contentType, std::string& body) {
+  init();
+  if (g_map.empty()) {
+    return false;
+  }
+  std::string path = requestPath.substr(0, requestPath.find_first_of("?#"));
+  if (path.empty() || path == "/") {
+    path = "/index.html";
+  }
+  if (path == "/jsonrpc" || path == "/rpc") {
+    return false;
+  }
+  if (path.find("..") != std::string::npos) {
+    return false;
+  }
+  std::string key = (path.front() == '/') ? path.substr(1) : path;
+  auto it = g_map.find(key);
+  if (it == g_map.end()) {
+    return false;
+  }
+  contentType = it->second.mime;
+  body.assign(it->second.data, it->second.len);
+  return true;
+}
+
+bool WebUiServer::isBundled() {
+  init();
+  return !g_map.empty();
+}
+
+} // namespace aria2
