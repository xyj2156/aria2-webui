+/*
+ * WebUiServer.h - Serve embedded Web UI assets over aria2's HTTP listener.
+ *
+ * This file is an addition to the aria2 source tree.  It is not part of the
+ * original aria2 distribution.
+ *
+ * Copyright (C) 2026 阿杰 <master@x-ac.cn>
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation, either version 3 of the License, or
+ * (at your option) any later version.
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+#ifndef D_WEB_UI_SERVER_H
+#define D_WEB_UI_SERVER_H
+
+#include "common.h"
+
+#include <string>
+
+namespace aria2 {
+
+// Serves the Web UI assets that were compiled into the aria2c binary at build
+// time (see scripts/gen_webui_blob.mjs -> src/WebUiBlob.cc).  The embedded blob
+// is a base64-encoded, zlib-deflated "AWEB" archive; it is decoded, inflated
+// and indexed lazily on first use.
+class WebUiServer {
+public:
+  // Maps an HTTP request path (e.g. "/", "/assets/app.js"; a query string or
+  // fragment is ignored) to an embedded asset.  On success, fills
+  // |contentType| and |body| and returns true.  Returns false for the RPC
+  // endpoint or an unknown path so the caller can fall through to normal
+  // handling.
+  static bool serve(const std::string& requestPath, std::string& contentType,
+                    std::string& body);
+
+  // Returns true when at least one asset was embedded in the binary.
+  static bool isBundled();
+};
+
+} // namespace aria2
+
+#endif // D_WEB_UI_SERVER_H
