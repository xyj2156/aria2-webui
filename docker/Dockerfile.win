# Cross-compile a fully static Windows aria2c.exe (with the Web UI embedded)
# from a Linux host using mingw-w64.  Dependency recipe mirrors aria2's own
# Dockerfile.mingw.  The patched aria2 source + built webui dist are provided at
# run time (mounted into the container); this image only supplies the toolchain
# and the prebuilt static dependency libraries under /usr/local/$HOST.
#
#   docker build -f docker/Dockerfile.win -t aria2-webui-win .
#   docker run --rm -v "$PWD":/w aria2-webui-win bash /w/patches/build-aria2-webui.sh
#
# (the workflow sets ARIA2_SRC/WEBUI_DIST/OUT/CONF_EXTRA/PKG_MODE env)
FROM ubuntu:22.04

ARG HOST=x86_64-w64-mingw32
ENV DEBIAN_FRONTEND=noninteractive
ENV HOST=${HOST}

RUN apt-get update && apt-get install -y --no-install-recommends \
      make binutils autoconf automake autotools-dev libtool patch \
      ca-certificates pkg-config git curl dpkg-dev xz-utils \
      gcc-mingw-w64 g++-mingw-w64 autopoint gettext python3-docutils nodejs \
    && rm -rf /var/lib/apt/lists/*

# --- static dependency libraries (mirror of aria2 Dockerfile.mingw) ---------
# Robust downloads with per-package mirror fallback: -f fails on HTTP errors,
# --retry/--retry-all-errors cover transient timeouts (a prior run died on curl
# exit 28 connecting to gmplib.org), and gmp prefers a GNU mirror with gmplib.org
# as backup.  No cross-host "-C" resume (avoids mixing partial files from mirrors).
RUN cd /tmp && set -eux && \
    dl() { for u in "$@"; do \
             if curl -fL --connect-timeout 20 --retry 5 --retry-delay 2 --retry-all-errors -O "$u"; then return 0; fi; \
             echo "mirror failed: $u" >&2; \
           done; return 1; } && \
    dl https://ftpmirror.gnu.org/gnu/gmp/gmp-6.3.0.tar.xz https://gmplib.org/download/gmp/gmp-6.3.0.tar.xz && \
    dl https://github.com/libexpat/libexpat/releases/download/R_2_5_0/expat-2.5.0.tar.bz2 && \
    dl https://www.sqlite.org/2023/sqlite-autoconf-3430100.tar.gz && \
    dl https://github.com/madler/zlib/releases/download/v1.3.1/zlib-1.3.1.tar.gz && \
    dl https://github.com/c-ares/c-ares/releases/download/cares-1_19_1/c-ares-1.19.1.tar.gz && \
    dl https://libssh2.org/download/libssh2-1.11.0.tar.bz2

RUN cd /tmp && tar xf gmp-6.3.0.tar.xz && cd gmp-6.3.0 && \
    ./configure --disable-shared --enable-static --prefix=/usr/local/$HOST \
        --host=$HOST --disable-cxx --enable-fat CFLAGS="-mtune=generic -O2 -g0" && \
    make -j$(nproc) install

RUN cd /tmp && tar xf expat-2.5.0.tar.bz2 && cd expat-2.5.0 && \
    ./configure --disable-shared --enable-static --prefix=/usr/local/$HOST \
        --host=$HOST --build=$(dpkg-architecture -qDEB_BUILD_GNU_TYPE) && \
    make -j$(nproc) install

RUN cd /tmp && tar xf sqlite-autoconf-3430100.tar.gz && cd sqlite-autoconf-3430100 && \
    ./configure --disable-shared --enable-static --prefix=/usr/local/$HOST \
        --host=$HOST --build=$(dpkg-architecture -qDEB_BUILD_GNU_TYPE) && \
    make -j$(nproc) install

RUN cd /tmp && tar xf zlib-1.3.1.tar.gz && cd zlib-1.3.1 && \
    CC=$HOST-gcc AR=$HOST-ar LD=$HOST-ld RANLIB=$HOST-ranlib STRIP=$HOST-strip \
    ./configure --prefix=/usr/local/$HOST --libdir=/usr/local/$HOST/lib \
        --includedir=/usr/local/$HOST/include --static && \
    make -j$(nproc) install

RUN cd /tmp && tar xf c-ares-1.19.1.tar.gz && cd c-ares-1.19.1 && \
    ./configure --disable-shared --enable-static --without-random \
        --prefix=/usr/local/$HOST --host=$HOST \
        --build=$(dpkg-architecture -qDEB_BUILD_GNU_TYPE) LIBS="-lws2_32" && \
    make -j$(nproc) install

RUN cd /tmp && tar xf libssh2-1.11.0.tar.bz2 && cd libssh2-1.11.0 && \
    ./configure --disable-shared --enable-static --prefix=/usr/local/$HOST \
        --host=$HOST --build=$(dpkg-architecture -qDEB_BUILD_GNU_TYPE) LIBS="-lws2_32" && \
    make -j$(nproc) install

# TLS on Windows uses WinTLS (SChannel) via the OS libs, so no OpenSSL needed.
WORKDIR /w
CMD ["bash"]
